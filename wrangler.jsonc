/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "morelord-gaming-web",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-08-04",
	"compatibility_flags": [
		"nodejs_compat",
		"nodejs_als"
	],

	"workers_dev": false,

	"routes": [
		{
			"pattern": "morelordgaming.com",
			"custom_domain": true
		}
	],

	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},

	"observability": {
		"enabled": true
	},

	"upload_source_maps": true,

	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "morelord-gaming",
			"database_id": "8d46052b-3c47-47bb-9324-307df5014376",
			"migrations_dir": "migrations"
		}
	]

	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": { "mode": "smart" }

	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform.
	 */

	/**
	 * Environment Variables
	 * Use secrets for sensitive values.
	 */
	// "vars": { "MY_VARIABLE": "production_value" }

	/**
	 * Service Bindings
	 */
	// "services": [
	//   {
	//     "binding": "MY_SERVICE",
	//     "service": "my-service"
	//   }
	// ]
}