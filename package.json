{
	"name": "morelord-gaming-web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "npm run gen && vite build",
		"preview": "npm run build && wrangler dev",
		"prepare": "svelte-kit sync || echo ''",
		"check": "npm run gen && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "npm run gen && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"gen": "npm run clean:cloudflare && wrangler types",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"auth:schema": "better-auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes",
		"deploy": "npm run build && wrangler deploy",
		"cf-typegen": "npm run gen",
		"db:migrate:local": "wrangler d1 migrations apply morelord-gaming --local",
		"db:migrate:remote": "wrangler d1 migrations apply morelord-gaming --remote",
		"clean:cloudflare": "node -e \"require('fs').rmSync('.svelte-kit/cloudflare', { recursive: true, force: true })\"",
		"dev:setup": "powershell -ExecutionPolicy Bypass -File ./scripts/dev-setup.ps1",
		"verify": "powershell -ExecutionPolicy Bypass -File ./scripts/verify.ps1",
		"test:smoke": "playwright test tests/site.e2e.ts",
		"auth:secret": "node scripts/generate-auth-secret.mjs"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24.13.3",
		"@vitest/browser-playwright": "^4.1.8",
		"auth": "^1.6.23",
		"better-auth": "^1.6.23",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"mdsvex": "^0.12.7",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1",
		"wrangler": "^4.118.0"
	},
	"dependencies": {
		"@fontsource/roboto-condensed": "^5.3.0",
		"@fortawesome/fontawesome-svg-core": "^7.3.1",
		"@fortawesome/free-regular-svg-icons": "^7.3.1",
		"@fortawesome/free-solid-svg-icons": "^7.3.1",
		"@fortawesome/svelte-fontawesome": "^0.2.4",
		"dompurify": "^3.4.13",
		"zod": "^4.4.3"
	}
}
